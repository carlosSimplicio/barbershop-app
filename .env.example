# Runtime
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
LOGO_STORAGE_DIR=/var/lib/barbershop/logos

# Authentication. Generate independent random values; never reuse development keys in production.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
JWT_ACTIVE_KEY_ID=local-1
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEYS_JSON={}
CSRF_SIGNING_KEY_BASE64=
RATE_LIMIT_HMAC_KEY_BASE64=
TRUSTED_ORIGINS=https://localhost:8443
TRUSTED_PROXY_CIDRS=172.30.0.4/32

# PostgreSQL
POSTGRES_DB=barbershop
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://barbershop:change-me@postgres:5432/barbershop?sslmode=disable

# Public routing
APP_ADDRESS=https://localhost:8443
PUBLIC_APP_URL=https://localhost:8443
CADDY_HTTP_PORT=8088
CADDY_HTTPS_PORT=8443

# Frontend server-side access to the API. Browser calls use /api/v1 through Caddy.
API_INTERNAL_URL=http://backend:8080

# Development-only SMTP sink
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@barbershop.local
MAILPIT_HTTP_PORT=8025
