# Runtime
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# PostgreSQL
POSTGRES_DB=barbershop
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://barbershop:change-me@postgres:5432/barbershop?sslmode=disable

# Public routing
APP_ADDRESS=http://localhost
CADDY_HTTP_PORT=8088
CADDY_HTTPS_PORT=8443

# Frontend server-side access to the API. Browser calls use /api/v1 through Caddy.
API_INTERNAL_URL=http://backend:8080

# Development-only SMTP sink
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
